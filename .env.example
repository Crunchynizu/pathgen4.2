# Copy to .env for local work. Never commit .env.
SECRET_KEY=change-me

# Development uses SQLite (db.sqlite3 in the project) when DATABASE_URL is unset: SQLite first.
# Switch to PostgreSQL once everything works, and always for the concurrency checks and production:
# DATABASE_URL=postgres://pathgen_user@localhost:5432/pathgen42

# Local Qwen feedback (optional; see README, "Qwen feedback"). Empty = off, the approved text is shown.
# LLM_BASE_URL=http://127.0.0.1:8080

# Production only (Railway sets these):
# ALLOWED_HOSTS=your-app.up.railway.app
# CSRF_TRUSTED_ORIGINS=https://your-app.up.railway.app
# MEDIA_ROOT=/data/media
